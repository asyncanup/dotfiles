# Focus west — try window first, then jump to next display
alt - h : yabai -m window --focus west || yabai -m display --focus west
alt - l : yabai -m window --focus east || yabai -m display --focus east
alt - k : yabai -m window --focus north || yabai -m display --focus north
alt - j : yabai -m window --focus south || yabai -m display --focus south

# ===== SWAP WINDOWS (Mod + Shift + hjkl) =====
shift + alt - h : yabai -m window --swap west || yabai -m window --display west; yabai -m display --focus west
shift + alt - l : yabai -m window --swap east || yabai -m window --display east; yabai -m display --focus east
shift + alt - j : yabai -m window --swap south || yabai -m window --display south; yabai -m display --focus south
shift + alt - k : yabai -m window --swap north || yabai -m window --display north; yabai -m display --focus north

# ===== RESIZE WINDOWS (Mod + Shift + arrow keys) =====
ctrl + shift + alt - left  : yabai -m window --resize left:-80:0
ctrl + shift + alt - left  : yabai -m window --resize left:-80:0
ctrl + shift + alt - right : yabai -m window --resize right:80:0
ctrl + shift + alt - up    : yabai -m window --resize top:0:-90
ctrl + shift + alt - down  : yabai -m window --resize bottom:0:90

# ===== SWITCH WORKSPACES/SPACES (Mod + 1-9) =====
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9
alt - 0 : yabai -m space --focus 10

# ===== MOVE WINDOW TO SPACE (Mod + Shift + 1-9) =====
shift + alt - 1 : yabai -m window --space 1
shift + alt - 2 : yabai -m window --space 2
shift + alt - 3 : yabai -m window --space 3
shift + alt - 4 : yabai -m window --space 4
shift + alt - 5 : yabai -m window --space 5
shift + alt - 6 : yabai -m window --space 6
shift + alt - 7 : yabai -m window --space 7
shift + alt - 8 : yabai -m window --space 8
shift + alt - 9 : yabai -m window --space 9
shift + alt - 0 : yabai -m window --space 10

# ===== MOVE WINDOW TO ADJACENT SPACE (Mod + Alt + left/right) =====
cmd + alt - left  : yabai -m window --space prev
cmd + alt - right : yabai -m window --space next

# ===== SWITCH TO ADJACENT SPACE (Mod + left/right) =====
ctrl + alt - left  : yabai -m space --focus prev
ctrl + alt - right : yabai -m space --focus next

# ===== FULLSCREEN (Mod + Return) =====
alt - return : yabai -m window --toggle zoom-fullscreen

# ===== TOGGLE FLOAT (Mod + Shift + F) =====
shift + alt - f : yabai -m window --toggle float

# ===== CLOSE WINDOW (Mod + W) =====
alt - w : yabai -m window --close

# ===== APP LAUNCHERS =====
alt - t : open -a kitty
alt - n : open -a kitty --args -e nvim
alt - f : open -a Marta

# ===== SCRATCHPAD (Mod + S) =====
# yabai doesn't have native scratchpad, but you can toggle a floating window
alt - s : yabai -m window --toggle float; yabai -m window --grid 5:5:1:1:3:3
