{
    "layer": "top",
    "position": "top",
    "height": 20,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": [],
    "modules-right": ["network", "cpu", "memory", "disk", "temperature", "battery", "pulseaudio", "clock"],
    
    "hyprland/workspaces": {
        "format": "{name}: {icon}",
        "format-icons": {
            "1": "󰞷 ",
            "2": "󰈹 ",
            "3": "󰗃 ",
            "4": "󰜗 ",
            "urgent": "",
            "focused": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": [1, 2, 3, 4]
        }
    },
    
    "hyprland/window": {
        "format": "{}",
        "separate-outputs": true
    },
    
    "clock": {
        "format": "{:%Y-%m-%d  🕒  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    
    "cpu": {
        "format": "CPU {usage}%",
        "tooltip": false
    },
    
    "memory": {
        "format": "MEM {}%"
    },
    
    "temperature": {
        "critical-threshold": 80,
        "format": "🌡️ {temperatureC}°C",
        "format-icons": ["", "", ""]
    },
    
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "🔋 {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-plugged": "🔌 {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    
    "network": {
        "format-wifi": "󰤨   {essid} {signalStrength}%",
        "format-ethernet": "󰈀",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "format-disconnected": "Disconnected ⚠"
    },
    
    "pulseaudio": {
        "format": "🔉 {volume}%",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": "󰝟 {icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "disk": {
        "format": "💾 {free}",
        "path": "/",
    },
    
    "tray": {
        "spacing": 10
    }
}
