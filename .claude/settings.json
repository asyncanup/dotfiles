{
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir'); cd \"$cwd\" && STARSHIP_SHELL=bash starship prompt 2>/dev/null | sed -n '2p' | sed 's/\\\\[][]//g'"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "atlassian@claude-plugins-official": false,
    "slack@claude-plugins-official": false
  },
  "alwaysThinkingEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash",
      "mcp__ts-pm__query_transcripts"
    ],
    "allowedPrompts": [
      { "tool": "Bash", "prompt": "grep" },
      { "tool": "Bash", "prompt": "ls" },
      { "tool": "Bash", "prompt": "list" },
      { "tool": "Bash", "prompt": "find" },
      { "tool": "Bash", "prompt": "search" },
      { "tool": "Bash", "prompt": "cat" },
      { "tool": "Bash", "prompt": "head" },
      { "tool": "Bash", "prompt": "tail" },
      { "tool": "Bash", "prompt": "read" },
      { "tool": "Bash", "prompt": "view" },
      { "tool": "Bash", "prompt": "show" },
      { "tool": "Bash", "prompt": "display" },
      { "tool": "Bash", "prompt": "pwd" },
      { "tool": "Bash", "prompt": "which" },
      { "tool": "Bash", "prompt": "file" },
      { "tool": "Bash", "prompt": "wc" },
      { "tool": "Bash", "prompt": "diff" },
      { "tool": "Bash", "prompt": "compare" },
      { "tool": "Bash", "prompt": "tree" },
      { "tool": "Bash", "prompt": "stat" },
      { "tool": "Bash", "prompt": "du" },
      { "tool": "Bash", "prompt": "df" },
      { "tool": "Bash", "prompt": "echo" },
      { "tool": "Bash", "prompt": "print" },
      { "tool": "Bash", "prompt": "date" },
      { "tool": "Bash", "prompt": "whoami" },
      { "tool": "Bash", "prompt": "env" },
      { "tool": "Bash", "prompt": "git status" },
      { "tool": "Bash", "prompt": "git log" },
      { "tool": "Bash", "prompt": "git diff" },
      { "tool": "Bash", "prompt": "git show" },
      { "tool": "Bash", "prompt": "git branch" },
      { "tool": "Bash", "prompt": "check" },
      { "tool": "Bash", "prompt": "verify" },
      { "tool": "Bash", "prompt": "inspect" },
      { "tool": "Bash", "prompt": "first" },
      { "tool": "Bash", "prompt": "limited" },
      { "tool": "Bash", "prompt": "top" },
      { "tool": "Bash", "prompt": "preview" },
      { "tool": "Bash", "prompt": "sample" },
      { "tool": "Bash", "prompt": "count" },
      { "tool": "Bash", "prompt": "pipe" }
    ]
  },
  "mcpServers": {
    "ts-pm": {
      "type": "stdio",
      "command": "/Users/abishnoi/src/maglev/.venv/bin/ts-pm-mcp"
    }
  }
}
